# ── EduBoard Professional Monorepo Environment Variables ──
# Copy this file to apps/api/.env and apps/web/.env, then fill in values.
# NEVER commit real .env files to version control.

# ══════════════════════════════════════════════════════════
#  apps/api/.env  — Backend (Express)
# ══════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3001

# Database (Legacy MySQL - Deprecated in favor of Firebase)
# DATABASE_URL="mysql://root:@localhost:3306/eduboard"

# Firebase (Core Database & Auth)
FIREBASE_PROJECT_ID=eduboard-ai
# Path to service account JSON (Required for backend admin tasks)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# JWT
JWT_SECRET=your_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# AI Services
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# AWS (For Production Storage)
AWS_ACCESS_KEY_ID=your_id
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=eduboard-storage

# ══════════════════════════════════════════════════════════
#  apps/web/.env  — Frontend (Next.js)
# ══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Firebase Client SDK (required for login/auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# Secondary / Fallback key slot for zero-downtime key rotation windows
NEXT_PUBLIC_FIREBASE_API_KEY_SECONDARY=your-secondary-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-ms-client-id
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_ENABLE_GESTURES=true
NEXT_PUBLIC_ENABLE_VOICE=true

# ══════════════════════════════════════════════════════════
#  OpenCode Module Integration Config
# ══════════════════════════════════════════════════════════
OPENCODE_ENABLED=true
OPENCODE_DB_PREFIX=opencode_
OPENCODE_SANDBOX_TIMEOUT_MS=10000
NEXT_PUBLIC_OPENCODE_API_URL=http://localhost:3001/api/opencode

