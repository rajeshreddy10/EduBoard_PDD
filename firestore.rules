rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);

      // Sub-collections (notifications, settings, history)
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
      match /history/{boardId} {
        allow read, write: if isOwner(userId);

        // Versions within history
        match /versions/{versionId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Global boards collection (for collaboration and public access)
    match /boards/{boardId} {
      allow read: if resource.data.is_public == true || resource.data.owner_id == request.auth.uid;
      allow write: if isSignedIn() && (
        !exists(/databases/$(database)/documents/boards/$(boardId)) ||
        resource.data.owner_id == request.auth.uid
      );

      match /versions/{versionId} {
        allow read: if get(/databases/$(database)/documents/boards/$(boardId)).data.owner_id == request.auth.uid;
        allow write: if get(/databases/$(database)/documents/boards/$(boardId)).data.owner_id == request.auth.uid;
      }
    }

    // Support and Feedback
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
