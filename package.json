{
  "name": "eduboard-monorepo",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "description": "EduBoard PDD — Web-Only Monorepo (Frontend + Backend)",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build --prefix apps/web",
    "build:api": "npm run build --prefix apps/api",
    "build": "npm run build:web",
    "start:web": "npm run start --prefix apps/web",
    "start:api": "npm run start --prefix apps/api",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "install:all": "npm install --prefix apps/web && npm install --prefix apps/api",
    "lint": "npm run lint --prefix apps/web && npm run lint --prefix apps/api",
    "test:load": "node scripts/run_load_test_suite.js",
    "test:selenium": "node selenium-tests/tests/login-tests.js",
    "test:appium": "node appium-tests/mobile-tests.js",
    "test:security": "node scripts/run_security_suite.js",
    "test:all-300": "node selenium-tests/tests/login-tests.js && node appium-tests/mobile-tests.js && node scripts/run_load_test_suite.js && node scripts/run_security_suite.js",
    "test:all-reports": "npm run test:all-300",
    "test": "npm run test --prefix apps/web && npm run test --prefix apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "exceljs": "^4.4.0",
    "nodemon": "^3.0.0",
    "selenium-webdriver": "^4.48.0"
  },
  "dependencies": {
    "flutter": "^0.0.5",
    "openai": "^6.48.0",
    "redis": "^6.2.1"
  }
}
