# ── EduBoard Web Frontend Environment Configuration ──
# Copy this file to .env.local and populate real credentials for local development or production.

# Backend API & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Firebase Client SDK Credentials (Required for Auth, Firestore & Cloud Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_API_KEY_SECONDARY=your-secondary-fallback-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Feature Flags
NEXT_PUBLIC_ENABLE_GESTURES=true
NEXT_PUBLIC_ENABLE_VOICE=true
