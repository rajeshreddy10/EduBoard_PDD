{
  "name": "eduboard-ai",
  "version": "2.0.0",
  "private": true,
  "description": "EduBoard - AI-powered gesture-controlled smart board desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:build:win": "next build && electron-builder --win",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:build:linux": "next build && electron-builder --linux",
    "lint": "eslint",
    "test": "jest --forceExit",
    "test:e2e": "cypress run",
    "server": "cd ../api && node index.js",
    "server:dev": "cd ../api && nodemon index.js",
    "db:init": "cd ../api && npm run db:init",
    "start:all": "concurrently \"npm run server\" \"npm run dev\"",
    "docker:build": "docker-compose -f docker/docker-compose.yml build",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.11.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@tensorflow-models/handpose": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "eduboard-monorepo": "file:../..",
    "firebase": "^12.18.0",
    "framer-motion": "^11.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "0.468.0",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-katex": "^3.1.0",
    "react-redux": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "cypress": "^13.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "typescript": "^5",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.eduboard.ai",
    "productName": "EduBoard",
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../api",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
